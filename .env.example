# ==========================================================
# PDM 2026.2 — template de configuração
#
#   cp .env.example .env
#
# Preencha o .env com os SEUS valores. O .env está no
# .gitignore e nunca vai para o repositório. Este arquivo
# aqui (.env.example) é versionado e só tem placeholder.
#
# Regra: se o valor identifica VOCÊ, ele mora aqui.
#        Se o valor é um SEGREDO, ele mora aqui e em mais
#        lugar nenhum — nunca dentro de um node do n8n,
#        nunca dentro de um .sql, nunca num print.
# ==========================================================


# ---------- Google Cloud ----------------------------------
# Preenchido no passo 1 do docs/01-monte-seu-ambiente-gcp.md.
# ATENÇÃO: é o ID do projeto, não o nome.
#   nome = "PDM 2026-2"   |   id = "pdm-2026-2-471203"
GCP_PROJECT_ID=seu-projeto-id-aqui

# Dataset criado no passo 5. Underscore, não hífen.
BQ_DATASET=pdm_2026_2

# Bucket criado no passo 4. Nome único no mundo.
GCS_BUCKET=seu-bucket-aqui

# Região do bucket E do dataset. Os dois na MESMA região,
# senão o BigQuery não lê o arquivo do Cloud Storage.
# us-central1 mantém o Cloud Storage dentro do Always Free.
GCP_REGION=us-central1

# Caminho completo do dataset dentro do bucket.
GCS_CSV_URI=gs://seu-bucket-aqui/imoveis/aula-pdm.csv


# ---------- Gemini ----------------------------------------
# Criada no passo 7, em aistudio.google.com/apikey
# SEGREDO. Não commite, não cole no chat, não mostre em print.
GEMINI_API_KEY=

# Modelo usado nos blocos de IA generativa.
GEMINI_MODEL=gemini-2.5-flash


# ---------- n8n (aulas de 13/11 e 27/11) ------------------
# A URL da instância da disciplina, informada em aula.
N8N_BASE_URL=

# Só preencha se você for usar a API pública do n8n.
# Para as aulas você NÃO precisa disto — a chave da API
# do n8n dá acesso total à instância.
# SEGREDO.
N8N_API_KEY=


# ---------- Canal de mensagem (aula de 27/11) -------------
# Escolha UM. Deixe o outro em branco.

# --- Opção A: Telegram (recomendado) ---
# Token entregue pelo @BotFather no Telegram, comando /newbot.
# SEGREDO — quem tem esse token controla o seu bot.
TELEGRAM_BOT_TOKEN=

# --- Opção B: WhatsApp via API não oficial ---
# Leia aulas/27-11-agente-whatsapp/README.md antes de usar.
# O número usado aqui corre risco real de banimento.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE=
